{
  "name": "operon-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Operon: The Type-Safe Operational Ontology & Decision Runtime for AI Agents and Enterprise Systems",
  "bin": {
    "operon": "./packages/cli/dist/bin.js"
  },
  "type": "module",
  "scripts": {
    "operon": "node packages/cli/dist/bin.js",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "oxlint --config oxlint.config.ts",
    "format": "oxfmt --check",
    "test:mutate": "stryker run",
    "verify:all": "node --experimental-strip-types .agents/skills/verify-operon/helpers/verify-all.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/tsgo": "0.45.0",
    "@mpsuesser/oxlint-plugin-effect": "^0.5.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "ultracite": "7.11.1",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.4.1"
}
