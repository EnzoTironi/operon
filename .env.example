# ==============================================================================
# Operon Telemetry & Observability Configuration
# ==============================================================================

# Sentry DSN for error tracking, span metrics, and log breadcrumbs
# Dedicated project: zoen-1r/operon
SENTRY_DSN=https://fd13cde85bdbbf34c919f1f0886bf038@o4512062230888448.ingest.us.sentry.io/4512062656217088
SENTRY_ORG=zoen-1r
SENTRY_PROJECT=operon
SENTRY_ENVIRONMENT=development
OPERON_RELEASE=operon@0.1.0

# PostHog Product & Operational Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Global Telemetry Killswitch (true | false)
OPERON_TELEMETRY_ENABLED=true

# ==============================================================================
# Operon cell (Postgres 17 in Docker via Alchemy). `pnpm cell:up` fills these in
# .env with random secrets; names only here, never real values.
# ==============================================================================
OPERON_POSTGRES_PASSWORD=
OPERON_POSTGRES_PORT=55432
OPERON_AUTH_SECRET=
OPERON_DATABASE_URL=postgresql://operon:<url-encoded-password>@127.0.0.1:55432/operon_local?sslmode=disable
